# BEGIN AGENTSCOPE LAB IP PATH INGRESS
redir /agentscope /agentscope/ 308
handle /agentscope/* {
	basic_auth {
		__AGENTSCOPE_BASIC_AUTH_USER__ __AGENTSCOPE_BASIC_AUTH_HASH__
	}
	header X-Content-Type-Options nosniff
	reverse_proxy __CADDY_HOST_GATEWAY__:15173 {
		header_up Host 127.0.0.1:15173
		header_up X-Forwarded-Proto http
		header_up X-Forwarded-Prefix /agentscope
	}
}

redir /agentscope-api /agentscope-api/ 308
handle_path /agentscope-api/* {
	basic_auth {
		__AGENTSCOPE_BASIC_AUTH_USER__ __AGENTSCOPE_BASIC_AUTH_HASH__
	}
	header X-Content-Type-Options nosniff
	reverse_proxy __CADDY_HOST_GATEWAY__:18080 {
		header_up Host 127.0.0.1:18080
		header_up X-Forwarded-Proto http
		header_up X-Forwarded-Prefix /agentscope-api
	}
}

redir /lab /lab/ 308
handle_path /lab/* {
	header X-Content-Type-Options nosniff
	reverse_proxy __CADDY_HOST_GATEWAY__:18280 {
		header_up Host 127.0.0.1:18280
		header_up X-Forwarded-Proto http
		header_up X-Forwarded-Prefix /lab
	}
}
# END AGENTSCOPE LAB IP PATH INGRESS
