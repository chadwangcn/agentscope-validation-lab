[Unit]
Description=Talk Think Memory Lab ReME 0.4.1.3
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=talkthinklab
Group=talkthinklab
WorkingDirectory=/var/lib/talk-think-memory-lab/reme
Environment=HOME=/var/lib/talk-think-memory-lab
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/talk-think-memory-lab/venv/bin/reme start workspace_dir=/var/lib/talk-think-memory-lab/reme service.host=127.0.0.1 service.port=12333
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/talk-think-memory-lab

[Install]
WantedBy=multi-user.target
